# Aivora Decision Engine · 部署环境变量（开发默认值）
# 用法：cd aivora-decision/infra && cp env.example .env
# .env 已被 .gitignore 拦截；生产环境请替换为强随机值或改走 secrets 注入。
# 本文件仅含开发占位值，可安全入库。
# 注意：AIVORA_DB_URL 的主机名 postgres 是 compose 内部服务名（仅 compose 网络内有效）。

# Postgres（decision-service 五表；主机名/库名与 docker-compose.yml 保持一致）
AIVORA_DB_URL=postgresql://aivora:aivora-dev@postgres:5432/aivora_decision
AIVORA_DB_PASSWORD=aivora-dev

# MinIO（工件存储预留）
MINIO_ROOT_USER=aivora
MINIO_ROOT_PASSWORD=minio-d

# Grafana（仅 w4 profile 需要）
GRAFANA_ADMIN_PASSWORD=grafana-d
